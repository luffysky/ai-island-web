[
  { "slug": "git-clone", "term": "git clone", "zh_name": "複製倉庫", "category": "tool", "langs": ["general"], "difficulty": 1, "plain": "把遠端（如 GitHub）的整個專案「抓一份到你電腦」，含全部歷史。開始參與一個專案的第一步。", "example": "git clone https://github.com/user/repo.git", "related": ["git", "fork", "git-pull"] },
  { "slug": "git-add", "term": "git add", "zh_name": "加入暫存", "category": "tool", "langs": ["general"], "difficulty": 1, "plain": "把改動「放進暫存區（staging）」，準備下次 commit。git add . 是加全部。像把要打包的東西先挑進箱子。", "related": ["commit", "staging-area"] },
  { "slug": "git-status", "term": "git status", "zh_name": "看狀態", "category": "tool", "langs": ["general"], "difficulty": 1, "plain": "看「哪些檔改了、哪些已暫存、在哪個分支」。卡住時先打這個看現況。", "related": ["git", "git-diff"] },
  { "slug": "git-diff", "term": "git diff", "zh_name": "看差異", "category": "tool", "langs": ["general"], "difficulty": 2, "plain": "看「改了什麼」的逐行對照（紅色刪、綠色加）。commit 前先 diff 確認改對了是好習慣。", "related": ["git-status", "commit"] },
  { "slug": "git-log", "term": "git log", "zh_name": "看歷史", "category": "tool", "langs": ["general"], "difficulty": 1, "plain": "看過去的 commit 紀錄（誰、何時、改了什麼訊息）。git log --oneline 一行一筆比較清爽。", "related": ["commit", "git-reflog"] },
  { "slug": "git-pull", "term": "git pull", "zh_name": "拉取更新", "category": "tool", "langs": ["general"], "difficulty": 1, "plain": "把遠端最新的改動「抓下來並合併」到你的分支。多人協作前先 pull，減少衝突。", "related": ["git-fetch", "git-push", "merge"] },
  { "slug": "git-fetch", "term": "git fetch", "zh_name": "抓取（不合併）", "category": "tool", "langs": ["general"], "difficulty": 2, "plain": "只把遠端的更新「抓下來看」，但不自動合併進你的分支。pull = fetch + merge。想先看再決定就用 fetch。", "related": ["git-pull", "merge"] },
  { "slug": "git-push", "term": "git push", "zh_name": "推送", "category": "tool", "langs": ["general"], "difficulty": 1, "plain": "把你本機的 commit「送上遠端」（如 GitHub），別人才看得到。", "related": ["commit", "force-push", "origin"] },
  { "slug": "git-stash", "term": "git stash", "zh_name": "暫存收起來", "category": "tool", "langs": ["general"], "difficulty": 2, "plain": "做到一半「先把改動收進口袋、讓工作區乾淨」去做別的事，之後 git stash pop 拿回來。", "related": ["git-checkout", "branch"] },
  { "slug": "git-checkout", "term": "git checkout / switch", "aliases": ["git switch"], "zh_name": "切換 / 還原", "category": "tool", "langs": ["general"], "difficulty": 2, "plain": "切換分支或還原檔案。新版建議用 git switch 換分支、git restore 還原檔案，語意更清楚。", "related": ["branch", "git-reset"] },
  { "slug": "git-reset", "term": "git reset", "zh_name": "重置", "category": "tool", "langs": ["general"], "difficulty": 3, "plain": "把分支「退回某個 commit」。--soft 保留改動、--hard 連改動一起丟掉（危險、丟了難救）。", "related": ["git-revert", "git-reflog", "commit"] },
  { "slug": "git-revert", "term": "git revert", "zh_name": "反做一個 commit", "category": "tool", "langs": ["general"], "difficulty": 3, "plain": "「新增一個 commit 來抵消某個舊 commit」，歷史保留、比 reset 安全，適合已 push 的東西。", "related": ["git-reset", "commit"] },
  { "slug": "git-rebase", "term": "git rebase", "zh_name": "變基", "category": "tool", "langs": ["general"], "difficulty": 3, "plain": "把你的一串 commit「搬到另一個基準點上」，讓歷史變直線、乾淨。⚠️ 別對已 push 給別人的分支 rebase。", "related": ["merge", "branch", "cherry-pick"] },
  { "slug": "cherry-pick", "term": "git cherry-pick", "zh_name": "揀選提交", "category": "tool", "langs": ["general"], "difficulty": 3, "plain": "從別的分支「只挑某一個 commit」搬過來，不用整個合併。", "related": ["git-rebase", "commit"] },
  { "slug": "git-reflog", "term": "git reflog", "zh_name": "操作歷史救援", "category": "tool", "langs": ["general"], "difficulty": 3, "plain": "記錄你 HEAD 的每一步移動。手滑 reset --hard 丟東西時，靠它找回失去的 commit 的救命工具。", "related": ["git-reset", "git-log"] },
  { "slug": "head", "term": "HEAD", "zh_name": "HEAD", "category": "tool", "langs": ["general"], "difficulty": 2, "plain": "指向「你現在所在的那個 commit / 分支」的指標。detached HEAD =「你站在某個 commit 上、不在任何分支」，改東西容易弄丟。", "related": ["branch", "commit", "git-checkout"] },
  { "slug": "origin", "term": "origin / upstream", "zh_name": "遠端別名", "category": "tool", "langs": ["general"], "difficulty": 2, "plain": "origin 是你 clone 來的那個遠端的預設名字；upstream 常指「原始專案」（你 fork 的來源）。", "related": ["git-remote", "fork", "git-push"] },
  { "slug": "git-remote", "term": "git remote", "zh_name": "遠端倉庫", "category": "tool", "langs": ["general"], "difficulty": 2, "plain": "設定 / 查看「你的專案連到哪些遠端」。git remote -v 看網址。", "related": ["origin", "git-push"] },
  { "slug": "fork", "term": "fork", "zh_name": "分叉", "category": "tool", "langs": ["general"], "difficulty": 2, "plain": "在 GitHub 上「複製別人的專案到你自己帳號底下」，之後可以自由改、再發 PR 貢獻回去。跟 clone（抓到本機）不同。", "related": ["clone", "pull-request", "upstream"] },
  { "slug": "clone", "term": "clone vs fork", "zh_name": "clone 與 fork 差別", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "fork =「複製到你的 GitHub 帳號」（雲端、可貢獻回去）；clone =「抓到你電腦本機」。想改開源專案：先 fork 再 clone。", "related": ["fork", "git-clone"] },
  { "slug": "staging-area", "term": "staging area", "zh_name": "暫存區", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "commit 前的「待打包區」。git add 把改動放進來、commit 才把它們封存。讓你能挑選「這次要提交哪些改動」。", "related": ["git-add", "commit", "working-directory"] },
  { "slug": "working-directory", "term": "working directory", "zh_name": "工作目錄", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "你電腦上「實際在編輯的檔案」。Git 的三層：工作目錄 → 暫存區(add) → 倉庫(commit)。", "related": ["staging-area", "commit"] },
  { "slug": "gitignore", "term": ".gitignore", "zh_name": "忽略清單", "category": "tool", "langs": ["general"], "difficulty": 2, "plain": "列出「不要被 Git 追蹤」的檔案（金鑰、node_modules、暫存檔）。⚠️ 金鑰務必 ignore、別 commit 上去。", "related": ["git", "environment-variable"] },
  { "slug": "git-blame", "term": "git blame", "zh_name": "追溯每行作者", "category": "tool", "langs": ["general"], "difficulty": 2, "plain": "看「每一行是誰、在哪個 commit 改的」。不是要罵人，是要找出某段程式的來龍去脈。", "related": ["git-log", "git-bisect"] },
  { "slug": "git-bisect", "term": "git bisect", "zh_name": "二分找壞掉的提交", "category": "tool", "langs": ["general"], "difficulty": 3, "plain": "用二分法「自動幫你找出是哪個 commit 弄壞的」：標好一個好、一個壞，它一路二分讓你測，很快揪出兇手。", "related": ["off-by-one", "regression", "debug"] },
  { "slug": "force-push", "term": "force push", "zh_name": "強制推送", "category": "slang", "langs": ["general"], "difficulty": 3, "plain": "git push --force「覆蓋遠端歷史」。⚠️ 會蓋掉別人的 commit，共用分支上是大忌；要用也用 --force-with-lease 較安全。", "related": ["git-push", "git-rebase"] },
  { "slug": "merge-conflict", "term": "merge conflict", "zh_name": "合併衝突", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "兩邊改到「同一個檔的同一段」，Git 不知道要哪個，就標出來 <<<< ==== >>>> 讓你手動選。別慌，選好留哪段、刪掉標記即可。", "related": ["merge", "git-rebase"] },
  { "slug": "select-sql", "term": "SELECT", "zh_name": "查詢", "category": "syntax", "langs": ["sql"], "difficulty": 1, "plain": "SQL 最基本：「從表格拿資料」。SELECT 欄位 FROM 表 WHERE 條件。* 是拿全部欄位。", "example": "SELECT name, age FROM users WHERE age > 18", "related": ["sql", "where-sql", "join"] },
  { "slug": "where-sql", "term": "WHERE", "zh_name": "篩選條件", "category": "syntax", "langs": ["sql"], "difficulty": 1, "plain": "SQL 的「只要符合條件的列」。配 = > < AND OR LIKE IN 使用。", "example": "WHERE city = '台北' AND age >= 18", "related": ["select-sql", "having"] },
  { "slug": "join", "term": "JOIN", "zh_name": "表格關聯", "category": "concept", "langs": ["sql"], "difficulty": 3, "plain": "把「兩張表照關聯欄接起來查」。INNER JOIN 只留兩邊都有的；LEFT JOIN 保留左表全部、右邊沒有補空。新手最常卡這。", "example": "SELECT * FROM orders JOIN users ON orders.user_id = users.id", "related": ["foreign-key", "select-sql", "n-plus-one"] },
  { "slug": "group-by", "term": "GROUP BY", "zh_name": "分組", "category": "syntax", "langs": ["sql"], "difficulty": 3, "plain": "「照某欄分組再算統計」，例如照城市分組算人數。配 COUNT/SUM/AVG 等彙總函式用。", "example": "SELECT city, COUNT(*) FROM users GROUP BY city", "related": ["aggregate", "having", "groupby"] },
  { "slug": "having", "term": "HAVING", "zh_name": "分組後篩選", "category": "syntax", "langs": ["sql"], "difficulty": 3, "plain": "「對分組後的結果再篩選」。WHERE 篩原始列、HAVING 篩分組後的彙總（如只要人數 > 10 的城市）。", "example": "GROUP BY city HAVING COUNT(*) > 10", "related": ["group-by", "where-sql"] },
  { "slug": "order-by", "term": "ORDER BY", "zh_name": "排序", "category": "syntax", "langs": ["sql"], "difficulty": 1, "plain": "「照某欄排序結果」，ASC 由小到大（預設）、DESC 由大到小。", "example": "ORDER BY created_at DESC", "related": ["select-sql", "limit-sql"] },
  { "slug": "limit-sql", "term": "LIMIT / OFFSET", "zh_name": "限制筆數 / 分頁", "category": "syntax", "langs": ["sql"], "difficulty": 2, "plain": "LIMIT 只拿前 N 筆、OFFSET 跳過前幾筆，用來做分頁。⚠️ PostgREST 預設就有 1000 筆上限要注意。", "example": "LIMIT 20 OFFSET 40", "related": ["pagination", "select-sql"] },
  { "slug": "aggregate", "term": "aggregate functions", "zh_name": "彙總函式", "category": "concept", "langs": ["sql"], "difficulty": 2, "plain": "把多列「算成一個值」：COUNT 數幾筆、SUM 加總、AVG 平均、MAX/MIN 最大最小。常配 GROUP BY。", "related": ["group-by", "range-builtin"] },
  { "slug": "distinct", "term": "DISTINCT", "zh_name": "去重", "category": "syntax", "langs": ["sql"], "difficulty": 1, "plain": "「只留不重複的值」。SELECT DISTINCT city 拿到所有不重複的城市。", "example": "SELECT DISTINCT city FROM users", "related": ["select-sql", "set"] },
  { "slug": "primary-key", "term": "primary key", "zh_name": "主鍵", "category": "concept", "langs": ["sql"], "difficulty": 2, "plain": "每張表「唯一辨識一列」的欄位（如 id），不能重複、不能空。像每個人的身分證字號。", "related": ["foreign-key", "index", "unique"] },
  { "slug": "foreign-key", "term": "foreign key", "zh_name": "外鍵", "category": "concept", "langs": ["sql"], "difficulty": 3, "plain": "一張表「指向另一張表主鍵」的欄位，建立關聯（如 orders.user_id 指向 users.id），保證關聯資料存在。", "related": ["primary-key", "join"] },
  { "slug": "index-sql", "term": "index (database)", "zh_name": "索引（資料庫）", "category": "concept", "langs": ["sql"], "difficulty": 3, "plain": "幫欄位建「目錄」讓查詢變快，像書的索引不用一頁頁翻。代價是佔空間、寫入稍慢。常查的欄位才加。", "related": ["primary-key", "big-o"] },
  { "slug": "insert-update-delete", "term": "INSERT / UPDATE / DELETE", "zh_name": "增改刪", "category": "syntax", "langs": ["sql"], "difficulty": 2, "plain": "INSERT 新增列、UPDATE 改、DELETE 刪。⚠️ UPDATE/DELETE 沒加 WHERE 會動到整張表，超危險，動手前先 SELECT 確認範圍。", "example": "DELETE FROM users WHERE id = 5", "related": ["select-sql", "transaction"] },
  { "slug": "subquery", "term": "subquery", "zh_name": "子查詢", "category": "concept", "langs": ["sql"], "difficulty": 3, "plain": "「查詢裡面再包一個查詢」，用內層的結果當外層的條件或來源。", "example": "WHERE id IN (SELECT user_id FROM orders)", "related": ["join", "select-sql"] },
  { "slug": "transaction", "term": "transaction", "zh_name": "交易", "category": "concept", "langs": ["sql"], "difficulty": 3, "plain": "「一組操作要嘛全成功、要嘛全取消」，避免做一半出錯留下爛帳（如轉帳扣了卻沒入）。BEGIN…COMMIT / ROLLBACK。", "related": ["acid", "insert-update-delete", "deadlock"] },
  { "slug": "acid", "term": "ACID", "zh_name": "ACID", "category": "concept", "langs": ["sql"], "difficulty": 3, "plain": "資料庫交易的四個保證：原子性(全有全無)、一致性、隔離性(交易間不互相干擾)、持久性(存了就不會不見)。", "related": ["transaction", "database"] },
  { "slug": "migration-db", "term": "database migration", "zh_name": "資料庫遷移", "category": "concept", "langs": ["sql"], "difficulty": 3, "plain": "「用版本控制的方式改資料庫結構」（建表、加欄位）。每個 migration 是一步，能重現、能回滾，團隊資料庫才一致。", "related": ["schema", "orm", "commit"] },
  { "slug": "schema", "term": "schema", "zh_name": "結構描述", "category": "concept", "langs": ["sql"], "difficulty": 2, "plain": "資料庫「有哪些表、每張表有哪些欄位、什麼型別、什麼關聯」的藍圖。", "related": ["primary-key", "migration-db"] },
  { "slug": "n-plus-one", "term": "N+1 query problem", "zh_name": "N+1 查詢問題", "category": "slang", "langs": ["sql"], "difficulty": 3, "plain": "先查一次拿到 N 筆，再「為每筆各查一次」→ 總共 N+1 次查詢，慢爆。解法：用 JOIN 或一次批次查（eager load）。ORM 很容易不小心中招。", "related": ["join", "orm", "big-o"] },
  { "slug": "deadlock", "term": "deadlock", "zh_name": "死鎖", "category": "concept", "langs": ["sql"], "difficulty": 3, "plain": "兩個交易「互相等對方放開鎖」，卡死誰也動不了。像兩人在窄門互讓又互堵。資料庫通常會偵測到並砍掉一個。", "related": ["transaction", "race-condition"] },
  { "slug": "null-sql", "term": "NULL (SQL)", "zh_name": "NULL（SQL）", "category": "concept", "langs": ["sql"], "difficulty": 2, "plain": "SQL 的「沒有值」。陷阱：NULL 不等於任何東西、連 NULL = NULL 都不成立，要用 IS NULL 判斷。", "related": ["null", "where-sql"] },
  { "slug": "unique-constraint", "term": "UNIQUE constraint", "zh_name": "唯一約束", "category": "concept", "langs": ["sql"], "difficulty": 2, "plain": "規定某欄「不能有重複值」（如 email）。搭配 upsert（有就更新、沒有就新增）很常用。", "related": ["primary-key", "index-sql"] },
  { "slug": "normalization", "term": "normalization", "zh_name": "正規化", "category": "concept", "langs": ["sql"], "difficulty": 3, "plain": "把資料「拆成多張表、避免重複」的設計原則。優點是不會有矛盾資料、好維護；缺點是查詢常要 JOIN。", "related": ["foreign-key", "join"] }
]
