[
  { "slug": "binary", "term": "binary", "zh_name": "二進位", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "電腦的語言：只有 0 跟 1。每一位是 2 的次方。10 進位的 5 = 二進位 101。所有資料底層都是它。", "related": ["hexadecimal", "bit-byte", "boolean"] },
  { "slug": "hexadecimal", "term": "hexadecimal (hex)", "zh_name": "十六進位", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "逢 16 進位，用 0-9 加 A-F。常見於顏色碼(#FF5733)、記憶體位址。比二進位短好讀，4 位二進位 = 1 位 hex。", "related": ["binary", "bit-byte"] },
  { "slug": "bit-byte", "term": "bit / byte", "zh_name": "位元 / 位元組", "category": "concept", "langs": ["general"], "difficulty": 1, "plain": "bit 是最小單位(0或1)、8 個 bit = 1 byte。檔案大小 KB/MB/GB 都是 byte 的倍數。網速常用 bit(Mbps)。", "related": ["binary", "encoding"] },
  { "slug": "bitwise", "term": "bitwise operators", "zh_name": "位元運算", "category": "syntax", "langs": ["general"], "difficulty": 3, "plain": "直接對二進位每一位做運算：& AND、| OR、^ XOR、<< 左移。用於旗標、權限、極致優化。日常少用但底層很重要。", "related": ["binary", "boolean-logic"] },
  { "slug": "overflow-number", "term": "integer overflow", "zh_name": "整數溢位", "category": "error", "langs": ["general"], "difficulty": 3, "plain": "數字「超過型別能存的最大值就繞回去」變成負數或亂數(C/Java 會，Python 大數不會)。金額計算要小心。", "related": ["integer", "float", "stack-overflow-error"] },
  { "slug": "floating-point-error", "term": "0.1 + 0.2 != 0.3", "zh_name": "浮點誤差", "category": "error", "langs": ["general"], "difficulty": 3, "plain": "電腦用二進位存小數會有微小誤差，所以 0.1+0.2 = 0.30000...4。比較小數別用 ==，錢用整數(分)或 Decimal 存。", "related": ["float", "integer"] },
  { "slug": "rounding", "term": "rounding", "zh_name": "四捨五入", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "把小數變整/減位。注意各語言規則不同(有的是銀行家捨入)、且浮點誤差會讓結果偶爾出乎意料。", "related": ["float", "floating-point-error"] },
  { "slug": "random-seed", "term": "random / seed", "zh_name": "亂數 / 種子", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "電腦的亂數其實是「偽亂數」——給同一個 seed 會產生同一串。測試時固定 seed 才能重現結果。", "related": ["math-module", "reproducibility"] },
  { "slug": "reproducibility", "term": "reproducibility", "zh_name": "可重現性", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "「同樣輸入/設定，跑出同樣結果」。固定亂數種子、鎖版本、記步驟，別人(和未來的你)才重現得出來。", "related": ["random-seed", "lockfile", "idempotent"] },
  { "slug": "recursion-vs-iteration", "term": "recursion vs iteration", "zh_name": "遞迴 vs 迴圈", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "同一件事兩種做法：遞迴(自己呼叫自己、優雅但耗堆疊)、迴圈(直接重複、省資源)。多數能互換，看哪個好讀。", "related": ["recursion", "loop", "stack-overflow-error"] },
  { "slug": "state-machine", "term": "state machine", "zh_name": "狀態機", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "「有哪些狀態、怎麼從一個轉到另一個」的模型(訂單：待付→已付→出貨→完成)。把複雜流程理清楚、少非法狀態。", "related": ["state", "enum"] },
  { "slug": "enum-flag", "term": "flag / boolean flag", "zh_name": "旗標", "category": "concept", "langs": ["general"], "difficulty": 1, "plain": "一個「開/關」的布林值來記狀態或控制行為(is_done、is_admin)。太多旗標交纏會很難懂，考慮用狀態機。", "related": ["boolean", "feature-flag", "state-machine"] },
  { "slug": "constant-time", "term": "constant time (O(1))", "zh_name": "常數時間", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "「不管資料多大都一樣快」的操作(如用 key 查字典)。是效率的理想。相對 O(n) 會隨資料變慢。", "related": ["big-o", "hash-table"] },
  { "slug": "amortized", "term": "amortized complexity", "zh_name": "攤銷複雜度", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "「平均下來」的複雜度：偶爾一次很貴、但攤到很多次操作就便宜(如陣列自動擴容)。", "related": ["big-o", "constant-time"] },
  { "slug": "invariant", "term": "invariant", "zh_name": "不變量", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "「在某段程式執行中永遠成立的條件」(如餘額不為負)。想清楚不變量能幫你寫對迴圈、抓 bug。", "related": ["assert", "state-machine"] },
  { "slug": "boundary-condition", "term": "boundary condition", "zh_name": "邊界條件", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "「最邊緣的輸入」：0、空、最大值、負數、只有一個元素。程式最常在這裡出錯，測試要特別涵蓋。", "related": ["edge-case", "off-by-one", "loading-error-empty"] },
  { "slug": "fail-fast", "term": "fail fast", "zh_name": "快速失敗", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "「一發現不對就馬上報錯停下」，而不是硬撐到後面爆更慘。早點噴錯反而好抓問題。", "related": ["assert", "input-validation", "exception"] },
  { "slug": "defensive-programming", "term": "defensive programming", "zh_name": "防禦性程式設計", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "「假設事情會出錯、先做好防護」：檢查輸入、處理 null、包 try/except。多寫一點、少半夜被叫醒。", "related": ["input-validation", "fail-fast", "sad-path"] },
  { "slug": "guard-clause", "term": "guard clause / early return", "zh_name": "衛述句 / 提早回傳", "category": "syntax", "langs": ["general"], "difficulty": 2, "plain": "「不符合條件就先 return 出去」，把例外情況擋在前面，主邏輯就不用一路縮排在 if 裡。程式更好讀。", "related": ["conditional", "readability", "defensive-programming"] },
  { "slug": "magic-string", "term": "magic string", "zh_name": "魔術字串", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "程式裡到處寫死的字串('admin'、'success')，打錯一個字就 bug 且難查。抽成常數或 enum 較安全。", "related": ["magic-number", "constant", "enum"] },
  { "slug": "dead-code", "term": "dead code", "zh_name": "死程式碼", "category": "slang", "langs": ["general"], "difficulty": 1, "plain": "「永遠跑不到、或沒人用」的程式碼。留著只會混淆、增加維護負擔。看到就清掉(Git 記得住歷史，不怕刪)。", "related": ["code-smell", "refactor", "boy-scout-rule"] },
  { "slug": "commented-out-code", "term": "commented-out code", "zh_name": "被註解掉的程式碼", "category": "slang", "langs": ["general"], "difficulty": 1, "plain": "「先用註解關掉、之後再說」的一坨舊 code。通常再也不會回來用，變垃圾。有 Git 就放心刪。", "related": ["dead-code", "comment", "commit"] },
  { "slug": "todo-comment", "term": "TODO / FIXME / HACK", "zh_name": "待辦註解", "category": "slang", "langs": ["general"], "difficulty": 1, "plain": "程式裡的標記：TODO(待做)、FIXME(這裡有問題待修)、HACK(這是權宜之計)。編輯器能一次列出來提醒你。", "related": ["technical-debt", "comment", "quick-and-dirty"] },
  { "slug": "linting", "term": "linter", "zh_name": "檢查器", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "「自動掃程式碼、抓可能的問題與不良寫法」的工具(ESLint、Ruff)。commit 前跑一下，省下低級錯與 review 口水。", "related": ["eslint", "code-smell", "ci-cd"] },
  { "slug": "formatter", "term": "code formatter", "zh_name": "格式化工具", "category": "concept", "langs": ["general"], "difficulty": 1, "plain": "「自動排版統一風格」的工具(Prettier、Black)。不用為縮排空格吵架，存檔自動整齊。", "related": ["eslint", "pep8", "tabs-vs-spaces"] },
  { "slug": "code-formatting-diff", "term": "格式化造成的大 diff", "zh_name": "格式化污染 diff", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "順手重排整個檔，讓 diff 一片紅綠、看不出真正改了什麼。格式化改動最好單獨一個 commit。", "related": ["formatter", "atomic-commit", "code-review"] },
  { "slug": "whitespace-diff", "term": "trailing whitespace", "zh_name": "行尾空白", "category": "slang", "langs": ["general"], "difficulty": 1, "plain": "行末多餘的空白，看不見但會污染 diff、惹 linter。編輯器設「存檔自動清除」就一勞永逸。", "related": ["whitespace", "formatter", "linting"] },
  { "slug": "concurrency-bug", "term": "concurrency bug", "zh_name": "並行 bug", "category": "error", "langs": ["general"], "difficulty": 3, "plain": "多執行緒/多請求同時動共用資料造成的錯(race condition、deadlock)。時有時無、超難重現，是最難的 bug 之一。", "related": ["race-condition", "deadlock", "heisenbug", "mutex"] },
  { "slug": "atomic-operation", "term": "atomic operation", "zh_name": "原子操作", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "「不可被中途打斷」的操作，要嘛全做完要嘛沒發生。多執行緒/發幣扣款靠它避免中間狀態出錯。", "related": ["transaction", "race-condition", "mutex"] },
  { "slug": "eventual-vs-strong", "term": "strong vs eventual consistency", "zh_name": "強一致 vs 最終一致", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "強一致 =「讀到的永遠是最新」(慢、難擴展)；最終一致 =「過一下才同步」(快、可擴展)。看場景取捨。", "related": ["eventual-consistency", "acid", "cap-theorem"] },
  { "slug": "graceful-migration", "term": "zero-downtime migration", "zh_name": "零停機遷移", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "改資料庫結構「不停機、不弄壞正在跑的舊版」。技巧：先加不刪、分階段、向後相容。急著一步到位容易出事。", "related": ["migration-db", "backward-compatibility", "blue-green"] },
  { "slug": "soft-delete", "term": "soft delete", "zh_name": "軟刪除", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "「不真的刪、只標記 deleted」，可復原、留稽核。相對硬刪(真的移除)。GDPR 要真刪時再硬刪。", "related": ["insert-update-delete", "backup"] },
  { "slug": "audit-log", "term": "audit log", "zh_name": "稽核日誌", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "「誰在何時做了什麼」的紀錄，用於追責、除錯、合規。敏感操作(改權限、金流)都該記。", "related": ["logging", "soft-delete", "observability-logs"] },
  { "slug": "gdpr", "term": "GDPR / privacy", "zh_name": "個資保護", "category": "reference", "langs": ["general"], "difficulty": 2, "plain": "個資保護法規(歐盟 GDPR、台灣個資法)：要取得同意、能讓使用者查詢/刪除自己的資料。做產品要顧到。", "related": ["audit-log", "soft-delete", "telemetry"] },
  { "slug": "feature-toggle-debt", "term": "flag debt", "zh_name": "旗標債", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "feature flag 上線後「忘了清掉」，累積一堆過期開關讓程式碼一團亂。放量完成就該移除。", "related": ["feature-flag", "technical-debt", "dead-code"] },
  { "slug": "graceful-deprecation", "term": "deprecation path", "zh_name": "汰換路徑", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "要淘汰舊功能/API「別直接砍」：先標記 deprecated、給替代方案、留過渡期、再移除。對使用者友善。", "related": ["deprecate", "backward-compatibility", "api-versioning"] },
  { "slug": "graceful-readme", "term": "onboarding doc", "zh_name": "上手文件", "category": "concept", "langs": ["general"], "difficulty": 1, "plain": "讓新人/新使用者「快速上手」的文件：怎麼裝、怎麼跑、去哪找什麼。好的 onboarding 省下無數重複問答。", "related": ["readme", "self-documenting", "estimation"] },
  { "slug": "yak-shave-loop", "term": "rabbit hole", "zh_name": "掉進兔子洞", "category": "slang", "langs": ["general"], "difficulty": 1, "plain": "「越查越深、離原目標越來越遠」的狀態。跟剃牦牛毛(yak shaving)類似。設個時限、卡住就先記下來回頭做。", "related": ["yak-shaving", "context-switching"] },
  { "slug": "smoke-signal", "term": "canary in the coal mine", "zh_name": "礦坑金絲雀", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "「最早出事的警訊」。監控裡某個指標先異常，就像金絲雀先倒，提醒你趕快處理。canary release 名字也來自這。", "related": ["canary", "monitoring", "postmortem"] }
]
