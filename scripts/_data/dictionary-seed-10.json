[
  { "slug": "design-pattern", "term": "design pattern", "zh_name": "設計模式", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "「常見問題的公認解法範本」。前人踩過坑整理出來的招式(單例、工廠、觀察者…)，讓你不用重新發明、溝通也有共同語言。", "related": ["singleton", "factory", "observer"] },
  { "slug": "singleton", "term": "singleton", "zh_name": "單例模式", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "保證「整個程式只有一個實例」的設計(如全域設定、連線池)。方便但被濫用會變成偽裝的全域變數。", "related": ["design-pattern", "global-nonlocal"] },
  { "slug": "factory", "term": "factory pattern", "zh_name": "工廠模式", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "「用一個函式/類別統一負責建立物件」，呼叫端不用管怎麼 new，好抽換、好維護。", "related": ["design-pattern", "abstraction"] },
  { "slug": "observer", "term": "observer pattern", "zh_name": "觀察者模式", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "「有變化就通知所有訂閱者」的模式。事件監聽、React 的狀態更新、發布訂閱都是它的體現。", "related": ["design-pattern", "event-listener", "reactive"] },
  { "slug": "mvc", "term": "MVC", "zh_name": "MVC 架構", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "把程式拆成 Model(資料)、View(畫面)、Controller(協調)。各司其職、好維護。很多後端框架的基本架構。", "related": ["separation-of-concerns", "django"] },
  { "slug": "dependency-injection", "term": "dependency injection", "aliases": ["DI"], "zh_name": "依賴注入", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "「把需要的東西從外面傳進來，而不是自己在裡面 new」。好測試(可塞假的)、好抽換。", "related": ["mocking", "abstraction", "composition"] },
  { "slug": "composition", "term": "composition over inheritance", "zh_name": "組合優於繼承", "category": "slang", "langs": ["general"], "difficulty": 3, "plain": "「用拼裝小元件(組合)勝過一路繼承」。繼承層層疊會很脆，組合更彈性。React 就偏好組合。", "related": ["inheritance", "oop", "design-pattern"] },
  { "slug": "solid", "term": "SOLID principles", "zh_name": "SOLID 原則", "category": "reference", "langs": ["general"], "difficulty": 3, "plain": "五條物件導向設計原則的縮寫(單一職責、開放封閉…)，教你把程式寫得好維護、好擴充、不牽一髮動全身。", "related": ["separation-of-concerns", "oop", "dry"] },
  { "slug": "separation-of-concerns", "term": "separation of concerns", "zh_name": "關注點分離", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "「一段程式只管一件事」，別把資料、畫面、邏輯全糊一起。這樣改一處不會炸別處。", "related": ["mvc", "solid", "encapsulation"] },
  { "slug": "coupling-cohesion", "term": "coupling / cohesion", "zh_name": "耦合 / 內聚", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "目標是「低耦合(模組間少互相依賴)、高內聚(一個模組內的東西關係緊密)」。這樣改動影響小、好懂。", "related": ["separation-of-concerns", "microservices"] },
  { "slug": "controlled-component", "term": "controlled component", "zh_name": "受控元件", "category": "concept", "langs": ["javascript"], "difficulty": 3, "plain": "React 表單「值由 state 控制」(value + onChange)，React 是唯一真相來源。相對的 uncontrolled 讓 DOM 自己管。", "related": ["state", "usestate", "react"] },
  { "slug": "useref", "term": "useRef", "zh_name": "useRef", "category": "syntax", "langs": ["javascript"], "difficulty": 3, "plain": "React Hook：存一個「改了不會觸發重畫」的值，或抓真實 DOM 元素(如聚焦輸入框)。跟 useState 的差別在它不觸發 re-render。", "related": ["hook", "usestate", "dom"] },
