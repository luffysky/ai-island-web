  { "slug": "mau-dau", "term": "MAU / DAU", "zh_name": "月/日活躍用戶", "category": "concept", "langs": ["general"], "difficulty": 1, "plain": "MAU = 一個月內有活躍的用戶數、DAU = 一天內的。衡量產品「多少人真的在用」的核心指標。DAU/MAU 看黏著度。", "related": ["retention", "churn", "cohort"] },
  { "slug": "retention", "term": "retention", "zh_name": "留存率", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "「用戶隔一段時間還回來用的比例」。比拉新更重要——留不住人，拉再多都是漏水的桶。", "related": ["churn", "mau-dau", "cohort"] },
  { "slug": "churn", "term": "churn", "zh_name": "流失率", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "「一段時間內離開/不再用的用戶比例」。churn 高代表產品留不住人。跟 retention 是一體兩面。", "related": ["retention", "mau-dau"] },
