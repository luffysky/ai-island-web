  { "slug": "portal", "term": "React portal", "zh_name": "傳送門", "category": "concept", "langs": ["javascript"], "difficulty": 3, "plain": "把元件「渲染到 DOM 樹的別處」(如 body)，讓彈窗、下拉選單不被父層的 overflow 裁切。", "related": ["dom", "component", "overflow"] },
