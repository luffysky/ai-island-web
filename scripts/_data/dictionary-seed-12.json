[
  { "slug": "nosql", "term": "NoSQL", "zh_name": "NoSQL", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "「非關聯式」資料庫的統稱(文件、鍵值、圖…)。彈性、好水平擴展，但通常放棄一些關聯式的嚴謹(JOIN、交易)。", "related": ["mongodb", "redis", "sql", "database"] },
  { "slug": "mongodb", "term": "MongoDB", "zh_name": "MongoDB", "category": "tool", "langs": ["general"], "difficulty": 2, "plain": "最紅的文件型 NoSQL：資料存成像 JSON 的文件、欄位彈性、不用先定 schema。適合結構常變的資料。", "related": ["nosql", "json", "postgresql"] },
  { "slug": "redis", "term": "Redis", "zh_name": "Redis", "category": "tool", "langs": ["general"], "difficulty": 2, "plain": "存在記憶體、超快的鍵值資料庫。常拿來做快取、session、排行榜、佇列、速率限制。", "related": ["cache", "nosql", "queue-system", "rate-limiting"] },
  { "slug": "postgresql", "term": "PostgreSQL", "zh_name": "PostgreSQL", "category": "tool", "langs": ["sql"], "difficulty": 2, "plain": "功能強大的開源關聯式資料庫，穩定、支援 JSON 與向量(pgvector)。AI 島(Supabase)底層就是它。", "related": ["sql", "database", "supabase"] },
  { "slug": "supabase", "term": "Supabase", "zh_name": "Supabase", "category": "tool", "langs": ["general"], "difficulty": 2, "plain": "「開源版 Firebase」：一包給你 PostgreSQL 資料庫、認證、即時、儲存、API，前端直接串。AI 島就用它。", "related": ["postgresql", "row-level-security", "backend-as-a-service"] },
  { "slug": "backend-as-a-service", "term": "BaaS", "aliases": ["backend as a service"], "zh_name": "後端即服務", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "「後端幫你包好」的服務(資料庫、認證、儲存)，前端直接用、不用自己架後端。Supabase、Firebase 都是。", "related": ["supabase", "serverless"] },
  { "slug": "row-level-security", "term": "row-level security", "aliases": ["RLS"], "zh_name": "列級安全", "category": "concept", "langs": ["sql"], "difficulty": 3, "plain": "資料庫層級的權限：「規定每個人只能看/改自己的那幾列」。PostgreSQL/Supabase 用它做多租戶隔離。", "related": ["postgresql", "least-privilege", "authentication"] },
  { "slug": "sharding", "term": "sharding", "zh_name": "分片", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "資料太大「切成好幾塊分到不同伺服器」。能撐更大量，但跨片查詢跟一致性變複雜。", "related": ["replication", "scaling", "eventual-consistency"] },
  { "slug": "replication", "term": "replication", "zh_name": "複寫", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "「資料同步存多份」到不同伺服器：主庫寫、副本讀，分散讀取壓力、也做備援。主庫掛了副本頂上。", "related": ["sharding", "eventual-consistency", "backup"] },
  { "slug": "backup", "term": "backup / disaster recovery", "zh_name": "備份 / 災難復原", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "「定期備份、且測過真的能還原」。沒測過的備份等於沒有。天有不測風雲，資料是最不能丟的東西。", "related": ["replication", "rollback"] },
  { "slug": "connection-pool", "term": "connection pool", "zh_name": "連線池", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "「預先開好一批資料庫連線重複用」，不用每次請求都重連(很貴)。高流量必備。開太少會塞、太多會壓垮 DB。", "related": ["database", "scaling", "singleton"] },
  { "slug": "aws", "term": "AWS / GCP / Azure", "zh_name": "雲端服務商", "category": "tool", "langs": ["general"], "difficulty": 2, "plain": "三大雲端平台(亞馬遜/Google/微軟)：租他們的伺服器、資料庫、儲存、AI 服務，按用量付費，不用自己買機器。", "related": ["s3", "serverless", "cloud"] },
  { "slug": "cloud", "term": "cloud computing", "zh_name": "雲端運算", "category": "concept", "langs": ["general"], "difficulty": 1, "plain": "「用網路租別人的電腦資源」而不是自己買主機。要多少租多少、隨開隨關。省下自建機房的麻煩。", "related": ["aws", "serverless", "scaling"] },
  { "slug": "s3", "term": "object storage (S3)", "zh_name": "物件儲存", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "雲端「存檔案(圖片、影片、備份)」的服務(如 AWS S3)。便宜、幾乎無限大、有網址可直接連。", "related": ["aws", "cdn", "cloud"] },
  { "slug": "iac", "term": "Infrastructure as Code", "aliases": ["Terraform", "IaC"], "zh_name": "基礎設施即程式碼", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "「用程式碼描述你要哪些伺服器/資源」(Terraform)，一鍵建出來、可版控、可重現。不用手動在雲端點半天。", "related": ["cloud", "ci-cd", "aws"] },
  { "slug": "vm-vs-container", "term": "VM vs container", "zh_name": "虛擬機 vs 容器", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "VM「連整個作業系統都虛擬」(重、隔離強)；container「共用主機 OS 只裝應用」(輕、快)。現代部署多用容器。", "related": ["container", "docker", "kubernetes"] },
  { "slug": "react-native", "term": "React Native", "zh_name": "React Native", "category": "tool", "langs": ["javascript"], "difficulty": 3, "plain": "用 React 寫「iOS/Android 原生 App」，一套程式碼兩平台。前端會 React 的人跨去做手機 App 的捷徑。", "related": ["react", "flutter", "pwa"] },
  { "slug": "flutter", "term": "Flutter", "zh_name": "Flutter", "category": "tool", "langs": ["general"], "difficulty": 3, "plain": "Google 的跨平台 App 框架(用 Dart 語言)，一套程式碼做 iOS/Android/Web，UI 自己畫、很順。", "related": ["react-native"] },
  { "slug": "native-app", "term": "native vs hybrid app", "zh_name": "原生 vs 混合 App", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "原生 = 用平台官方語言各做一套(效能最好、最貴)；混合/跨平台 = 一套程式碼多平台(省成本、稍犧牲)。", "related": ["react-native", "flutter", "pwa"] },
