  { "slug": "oauth-scope", "term": "OAuth scope / consent", "zh_name": "授權範圍 / 同意", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "OAuth 授權時「你同意給對方哪些權限」(只讀 email？還是能發文？)。給最小必要就好，看清楚同意畫面。", "related": ["oauth", "least-privilege", "authentication"] },
  { "slug": "webhook-signature", "term": "webhook signature", "zh_name": "webhook 簽章驗證", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "收 webhook(如金流通知)時「驗證簽章確認真的是對方發的」，不然壞人偽造一個假付款成功你就慘了。", "related": ["webhook", "encryption", "idempotency-key"] },
  { "slug": "cdn-cache-invalidation", "term": "cache invalidation", "zh_name": "快取失效", "category": "slang", "langs": ["general"], "difficulty": 3, "plain": "「什麼時候該把舊快取清掉換新的」——工程界兩大難題之一。太早清沒省到、太晚清給人看舊資料。", "related": ["cache", "naming", "cdn"] },
  { "slug": "graceful-retry", "term": "retry / exponential backoff", "zh_name": "重試 / 指數退避", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "請求失敗時「隔一下再試，且每次等更久」(1秒→2秒→4秒)，避免一直猛打把對方壓垮。要配冪等一起用。", "related": ["idempotent", "rate-limiting", "backpressure"] },
  { "slug": "circuit-breaker", "term": "circuit breaker", "zh_name": "斷路器", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "某服務一直失敗時「暫時不再打它、直接回退」，等它恢復再放行。像保險絲跳掉，避免雪崩式連鎖失敗。", "related": ["graceful-retry", "graceful-degradation", "backpressure"] },
  { "slug": "blue-collar-oncall", "term": "on-call / incident", "zh_name": "值班 / 事故", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "on-call = 輪值「線上出事要隨時處理」；incident = 一次線上事故。半夜被叫起來救火是工程師的痛。", "related": ["postmortem", "monitoring", "hotfix"] },
  { "slug": "pair-programming", "term": "pair programming", "zh_name": "結對編程", "category": "slang", "langs": ["general"], "difficulty": 1, "plain": "「兩個人一起寫一份 code」，一個打字一個看/想。即時 review、傳承知識、少低級錯，但也耗人力。", "related": ["code-review", "rubber-duck-debugging"] },
  { "slug": "burnout", "term": "burnout", "zh_name": "職業倦怠", "category": "slang", "langs": ["general"], "difficulty": 1, "plain": "長期高壓、加班「燒到身心俱疲、失去動力」。這行很容易中招。學會休息、設界線跟寫程式一樣重要。", "related": ["imposter-syndrome", "toil", "blue-collar-oncall"] },
  { "slug": "yagni-vs-scalable", "term": "premature scaling", "zh_name": "過早擴展", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "「還沒有用戶就急著做能撐百萬人的架構」。多數新專案先簡單能動、有問題再說，別為想像的規模自找麻煩。", "related": ["over-engineering", "yagni", "scaling", "microservices"] },
  { "slug": "greenfield-tech-debt", "term": "shipping beats perfection", "zh_name": "先上線勝過完美", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "「做出來丟給使用者、拿真實回饋」比關在房裡打磨到完美有用。完美主義常是拖延的藉口。但別把它當亂做的擋箭牌。", "related": ["mvp", "ship-it", "gold-plating"] },
  { "slug": "cargo-cult-2", "term": "stack overflow driven development", "zh_name": "貼上驅動開發", "category": "slang", "langs": ["general"], "difficulty": 1, "plain": "自嘲：「從 Stack Overflow 複製貼上直到能動」。救急可以，但至少弄懂你貼了什麼，不然出事不知怎麼修。", "related": ["cargo-cult", "copy-paste", "rtfm"] },
  { "slug": "chesterton-fence", "term": "Chesterton's fence", "zh_name": "柴斯特頓的籬笆", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "「看不懂某段舊 code/設計為何存在，先別急著刪」——它可能在擋你沒看到的問題。搞懂再動。", "related": ["legacy-code", "chesterton-fence", "refactor"] },
  { "slug": "boy-scout-rule", "term": "boy scout rule", "zh_name": "童子軍規則", "category": "slang", "langs": ["general"], "difficulty": 1, "plain": "「離開時讓營地比你來時更乾淨」——每次碰到 code 就順手改善一點點，長久下來品質自然變好。", "related": ["refactor", "technical-debt", "code-smell"] },
  { "slug": "law-of-demeter", "term": "Law of Demeter", "zh_name": "迪米特法則", "category": "reference", "langs": ["general"], "difficulty": 3, "plain": "「只跟直接朋友講話」：別 a.b.c.d 一路穿透好幾層拿東西，耦合太深、一改就斷。", "related": ["coupling-cohesion", "encapsulation", "law-of-demeter"] },
  { "slug": "principle-of-least-astonishment", "term": "least astonishment", "zh_name": "最少驚訝原則", "category": "reference", "langs": ["general"], "difficulty": 2, "plain": "「讓程式/介面照大家直覺的方式運作」，別搞出意外行為嚇到使用者或同事。命名、API 設計都適用。", "related": ["naming", "readability", "footgun"] },
  { "slug": "commit-often", "term": "commit early, commit often", "zh_name": "常 commit", "category": "slang", "langs": ["general"], "difficulty": 1, "plain": "「小步、頻繁地存檔(commit)」。改動小好回滾、好 review，也不會辛苦半天遇到當機全沒了。", "related": ["atomic-commit", "commit", "conventional-commits"] },
  { "slug": "premature-abstraction", "term": "premature abstraction", "zh_name": "過早抽象", "category": "slang", "langs": ["general"], "difficulty": 3, "plain": "「才寫兩個案例就急著抽成通用框架」，常抽錯方向、越弄越複雜。規則：出現三次重複再抽(rule of three)。", "related": ["abstraction", "dry", "over-engineering", "yagni"] },
  { "slug": "rule-of-three", "term": "rule of three", "zh_name": "三次法則", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "「同樣的東西出現第三次，才值得抽成共用」。抽太早常猜錯需求，抽太晚才動手剛好。", "related": ["dry", "premature-abstraction", "refactor"] },
  { "slug": "estimation", "term": "estimation / story points", "zh_name": "工時估算 / 點數", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "估「一個任務要多久/多難」。工程師公認超難估，通常會低估。用相對點數(不是絕對小時)較實際。", "related": ["standup", "scope-creep", "definition-of-done"] },
  { "slug": "hofstadter-law", "term": "Hofstadter's Law", "zh_name": "侯世達定律", "category": "slang", "langs": ["general"], "difficulty": 1, "plain": "「事情總是比你預期的久，就算你已經把這條定律算進去了」。工時估算的殘酷真相，留點緩衝。", "related": ["estimation", "scope-creep"] },
  { "slug": "context-switching", "term": "context switching", "zh_name": "情境切換成本", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "「一直被打斷、在多件事間切換」很耗神，重新進入狀態要時間。工程師需要整段不被打擾的專注時間。", "related": ["toil", "burnout"] },
  { "slug": "flow-state", "term": "flow state / in the zone", "zh_name": "心流", "category": "slang", "langs": ["general"], "difficulty": 1, "plain": "「完全投入、思路順到忘記時間」的專注狀態，寫 code 效率最高。所以工程師最怕被打斷、被會議切碎。", "related": ["context-switching"] }
]
