  { "slug": "graphql-schema", "term": "GraphQL schema / resolver", "zh_name": "GraphQL 綱要/解析器", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "GraphQL 用 schema 定義「有哪些資料、怎麼查」，resolver 負責「實際去拿每個欄位的資料」。", "related": ["graphql", "rest-api", "orm"] },
  { "slug": "cdn-edge", "term": "edge computing / edge function", "zh_name": "邊緣運算", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "把運算「放到離使用者近的節點跑」(CDN 邊緣)，延遲更低。Next.js 的 edge function、Cloudflare Workers 都是。", "related": ["cdn", "serverless", "latency-throughput"] },
