[
  { "slug": "binary-search", "term": "binary search", "zh_name": "二分搜尋", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "在「已排序」的資料裡找東西：每次對半砍、看在左半還右半，超快（O(log n)）。像猜數字每次猜中間。", "related": ["sorting", "big-o", "divide-conquer"] },
  { "slug": "linear-search", "term": "linear search", "zh_name": "線性搜尋", "category": "concept", "langs": ["general"], "difficulty": 1, "plain": "「一個一個從頭找」直到找到。簡單但慢（O(n)）。資料沒排序時只能這樣。", "related": ["binary-search", "big-o"] },
  { "slug": "sorting", "term": "sorting algorithms", "zh_name": "排序演算法", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "把資料排順序的方法。實務上直接用內建 sort（通常是 O(n log n)）；面試才會問氣泡/快速/合併排序的原理。", "related": ["quicksort", "merge-sort", "sorted", "big-o"] },
  { "slug": "quicksort", "term": "quicksort", "zh_name": "快速排序", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "選一個基準值，把比它小的丟左邊、大的丟右邊，再各自遞迴排。平均很快（O(n log n)）。", "related": ["sorting", "divide-conquer", "recursion"] },
  { "slug": "merge-sort", "term": "merge sort", "zh_name": "合併排序", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "一直對半拆到剩一個，再兩兩合併成有序。穩定、保證 O(n log n)，是分治法的經典。", "related": ["sorting", "divide-conquer"] },
  { "slug": "divide-conquer", "term": "divide and conquer", "zh_name": "分治法", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "「把大問題拆成小問題、各自解、再合併」。二分搜尋、合併排序都是這招。", "related": ["recursion", "merge-sort", "binary-search"] },
  { "slug": "hash-table", "term": "hash table", "zh_name": "雜湊表", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "用雜湊把鍵直接算出「該放哪格」，所以查找、插入都近乎 O(1) 超快。字典/dict/map 底層就是它。", "related": ["hash", "dictionary-term", "big-o"] },
  { "slug": "linked-list", "term": "linked list", "zh_name": "鏈結串列", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "每個節點「記著下一個在哪」串成一串。插入刪除快，但要照順序走、不能像陣列直接跳第 N 個。", "related": ["array", "pointer", "stack"] },
  { "slug": "tree", "term": "tree", "zh_name": "樹", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "一種「一個根、往下分支」的階層結構（像家譜、資料夾）。二元樹是每個節點最多兩個子節點。", "related": ["binary-search-tree", "graph", "bfs-dfs"] },
  { "slug": "binary-search-tree", "term": "binary search tree", "aliases": ["BST"], "zh_name": "二元搜尋樹", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "有序的二元樹：左子樹都比自己小、右子樹都比自己大。查找像二分搜尋一樣快（平衡時）。", "related": ["tree", "binary-search"] },
  { "slug": "graph", "term": "graph", "zh_name": "圖", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "由「節點 + 連線」組成的結構，用來表示關係網（社群、地圖、網頁連結）。可有方向、可有權重。", "related": ["tree", "bfs-dfs"] },
  { "slug": "bfs-dfs", "term": "BFS / DFS", "zh_name": "廣度 / 深度優先搜尋", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "走訪圖/樹的兩種方式：BFS 一層層往外擴（找最短路好用、用佇列）；DFS 一路走到底再回頭（用堆疊/遞迴）。", "related": ["graph", "tree", "queue", "stack"] },
  { "slug": "dynamic-programming", "term": "dynamic programming", "aliases": ["DP"], "zh_name": "動態規劃", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "把大問題拆小、且「把算過的小答案記起來別重算」。適合有重複子問題的題（爬樓梯、背包）。面試大魔王。", "related": ["memoization", "recursion", "greedy"] },
  { "slug": "memoization", "term": "memoization", "zh_name": "記憶化", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "「把函式算過的結果存起來，同樣輸入直接回」，避免重複計算。是動態規劃的核心手法。", "related": ["dynamic-programming", "cache", "itertools"] },
  { "slug": "greedy", "term": "greedy algorithm", "zh_name": "貪婪演算法", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "「每一步都選當下看起來最好的」。有時能得到最佳解、有時會被局部最佳騙。找零錢常用。", "related": ["dynamic-programming", "backtracking"] },
  { "slug": "backtracking", "term": "backtracking", "zh_name": "回溯法", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "「試一條路，走不通就退回上一步換一條」。解迷宮、排列組合、數獨常用。", "related": ["recursion", "bfs-dfs"] },
  { "slug": "two-pointers", "term": "two pointers", "zh_name": "雙指標", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "用兩個指標（常一頭一尾）夾著掃，把 O(n²) 降到 O(n)。找兩數之和、反轉陣列常用。", "related": ["sliding-window", "array"] },
  { "slug": "sliding-window", "term": "sliding window", "zh_name": "滑動視窗", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "維持一個「會滑動的區間」邊移動邊算，處理連續子陣列/子字串的題很有效率。", "related": ["two-pointers", "array"] },
  { "slug": "heap", "term": "heap / priority queue", "zh_name": "堆積 / 優先佇列", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "能「一直快速拿出最大(或最小)的」資料結構。找 Top K、排程常用。", "related": ["queue", "sorting"] },
