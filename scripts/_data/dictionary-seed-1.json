[
  { "slug": "variable", "term": "variable", "zh_name": "變數", "category": "concept", "langs": ["general"], "difficulty": 1, "plain": "一個「貼了標籤的盒子」，用來裝資料。你之後用標籤（名字）就能拿到裡面的東西，也能換掉裡面的內容。", "analogy": "像便當盒外面貼「午餐」，打開就是今天的菜；明天換菜，標籤還是「午餐」。", "example": "age = 18   # 盒子叫 age、裝著 18", "related": ["value", "assignment", "constant"] },
  { "slug": "function", "term": "function", "aliases": ["func"], "zh_name": "函式", "category": "concept", "langs": ["general"], "difficulty": 1, "plain": "把一串常用步驟打包成一顆「按鈕」，取個名字；之後要用只要按一下（呼叫）就好，不用每次重寫。", "analogy": "像果汁機的「打果汁」鍵：丟水果進去、按一下、出果汁。", "example": "def greet(name):\n    return \"嗨 \" + name", "related": ["parameter", "argument", "return", "callback"] },
  { "slug": "parameter", "term": "parameter", "zh_name": "參數", "category": "concept", "langs": ["general"], "difficulty": 1, "plain": "函式定義時預留的「空格」，代表『等下你會給我什麼』。跟 argument 常被搞混：parameter 是名牌、argument 是真正塞進去的東西。", "example": "def add(a, b):  # a、b 是 parameter", "related": ["argument", "function"] },
  { "slug": "argument", "term": "argument", "aliases": ["arg"], "zh_name": "引數", "category": "concept", "langs": ["general"], "difficulty": 1, "plain": "呼叫函式時真正塞進去的值。parameter 是空格、argument 是你填進空格的東西。", "example": "add(3, 5)  # 3、5 是 argument", "related": ["parameter", "function"] },
  { "slug": "return", "term": "return", "zh_name": "回傳", "category": "syntax", "langs": ["general"], "difficulty": 1, "plain": "函式做完事、把結果「交出去」給呼叫它的人。碰到 return，函式就結束了。", "example": "def double(x):\n    return x * 2", "related": ["function"] },
  { "slug": "loop", "term": "loop", "zh_name": "迴圈", "category": "concept", "langs": ["general"], "difficulty": 1, "plain": "叫電腦「重複做同一件事」的方式，不用複製貼上一百遍。常見有 for（做固定次數）跟 while（條件成立就一直做）。", "analogy": "像洗碗：一個接一個洗，直到水槽空了。", "related": ["for-loop", "while-loop", "iteration", "break", "continue"] },
  { "slug": "for-loop", "term": "for loop", "zh_name": "for 迴圈", "category": "syntax", "langs": ["general"], "difficulty": 1, "plain": "跑「已知次數」或「把一排東西一個個拿出來」的迴圈。", "example": "for i in range(3):\n    print(i)   # 印 0 1 2", "related": ["loop", "while-loop", "range"] },
  { "slug": "while-loop", "term": "while loop", "zh_name": "while 迴圈", "category": "syntax", "langs": ["general"], "difficulty": 1, "plain": "「條件成立就一直做」的迴圈。小心條件永遠成立 → 變成無窮迴圈跑不停。", "example": "n = 0\nwhile n < 3:\n    n += 1", "related": ["loop", "for-loop", "infinite-loop", "break"] },
  { "slug": "break", "term": "break", "zh_name": "中斷", "category": "syntax", "langs": ["general"], "difficulty": 1, "plain": "在迴圈中間「立刻跳出」整個迴圈，不再繼續。", "example": "for x in nums:\n    if x < 0: break", "related": ["continue", "loop"] },
  { "slug": "continue", "term": "continue", "zh_name": "跳過本輪", "category": "syntax", "langs": ["general"], "difficulty": 1, "plain": "在迴圈裡「跳過這一輪剩下的動作」，直接進下一輪；跟 break（整個跳出）不一樣。", "related": ["break", "loop"] },
  { "slug": "array", "term": "array", "aliases": ["list"], "zh_name": "陣列 / 清單", "category": "concept", "langs": ["general"], "difficulty": 1, "plain": "一排有順序的格子，可以裝很多東西，用「編號（index）」拿第幾個。編號從 0 開始。", "analogy": "像一排信箱，1 樓的信箱編號是 0。", "example": "fruits = [\"蘋果\", \"香蕉\"]  # fruits[0] 是蘋果", "related": ["index", "list", "loop"] },
  { "slug": "index", "term": "index", "zh_name": "索引 / 編號", "category": "concept", "langs": ["general"], "difficulty": 1, "plain": "陣列裡「第幾個」的編號，從 0 開始數。所以第一個是 index 0、第二個是 1。", "example": "arr[0]  # 第一個", "related": ["array", "off-by-one", "index-error"] },
  { "slug": "dictionary-term", "term": "dictionary", "aliases": ["dict", "map", "hash map"], "zh_name": "字典 / 對映", "category": "concept", "langs": ["general"], "difficulty": 1, "plain": "用「鑰匙」查「值」的資料結構，不靠順序。想知道某人的電話就用他的名字（鑰匙）去查。", "analogy": "像真的字典：用「單字」查「解釋」。", "example": "phone = {\"小明\": \"0912\"}", "related": ["hash", "key-value", "array"] },
  { "slug": "boolean", "term": "boolean", "aliases": ["bool"], "zh_name": "布林值", "category": "concept", "langs": ["general"], "difficulty": 1, "plain": "只有兩種值的資料：真（true）或假（false）。程式判斷「要不要做」時就靠它。", "example": "is_adult = age >= 18", "related": ["conditional", "operator"] },
  { "slug": "string", "term": "string", "aliases": ["str"], "zh_name": "字串", "category": "concept", "langs": ["general"], "difficulty": 1, "plain": "一串文字。通常用引號包起來，讓電腦知道「這是字、不是指令」。", "example": "name = \"AI 島\"", "related": ["variable", "integer"] },
  { "slug": "integer", "term": "integer", "aliases": ["int"], "zh_name": "整數", "category": "concept", "langs": ["general"], "difficulty": 1, "plain": "沒有小數點的數字，例如 -3、0、42。跟 float（有小數）分開。", "related": ["float", "string"] },
  { "slug": "float", "term": "float", "zh_name": "浮點數", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "有小數點的數字，例如 3.14。電腦存小數會有微小誤差，所以 0.1 + 0.2 不一定剛好等於 0.3。", "related": ["integer"] },
  { "slug": "null", "term": "null", "aliases": ["nil", "none", "None"], "zh_name": "空值", "category": "concept", "langs": ["general"], "difficulty": 1, "plain": "代表「什麼都沒有 / 還沒有值」。注意：null 不等於 0、也不等於空字串，是「根本沒東西」。", "related": ["undefined", "null-pointer"] },
  { "slug": "conditional", "term": "conditional (if/else)", "aliases": ["if", "if-else"], "zh_name": "條件判斷", "category": "syntax", "langs": ["general"], "difficulty": 1, "plain": "讓程式「看情況做不同事」：如果…就…否則…。", "example": "if age >= 18:\n    print(\"成年\")\nelse:\n    print(\"未成年\")", "related": ["boolean", "operator"] },
  { "slug": "operator", "term": "operator", "zh_name": "運算子", "category": "syntax", "langs": ["general"], "difficulty": 1, "plain": "做運算的符號，例如 + - * /（算術）、== != > <（比較）、and or not（邏輯）。", "example": "3 == 3   # True", "related": ["conditional", "boolean"] },
  { "slug": "recursion", "term": "recursion", "zh_name": "遞迴", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "函式「自己呼叫自己」來解問題。一定要有「停下來的條件」，不然會無限套下去爆掉。", "analogy": "像兩面鏡子對照，影像一層套一層。", "related": ["function", "stack-overflow"] },
  { "slug": "algorithm", "term": "algorithm", "zh_name": "演算法", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "解決某個問題的「步驟食譜」。同一個問題可以有很多種演算法，有的快有的慢。", "analogy": "像煮飯的食譜：一步步照著做就有結果。", "related": ["data-structure", "big-o"] },
  { "slug": "data-structure", "term": "data structure", "zh_name": "資料結構", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "把資料「怎麼擺放」的方式，例如陣列、字典、堆疊、佇列。擺法選對，找東西才快。", "related": ["array", "stack", "queue", "hash"] },
  { "slug": "big-o", "term": "Big O", "aliases": ["time complexity"], "zh_name": "時間複雜度 / 大 O", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "描述「資料變多時，程式會變多慢」的粗略等級。O(n) 是資料翻倍、時間翻倍；O(n²) 是資料翻倍、時間變四倍（很雷）。", "related": ["algorithm"] },
  { "slug": "api", "term": "API", "aliases": ["application programming interface"], "zh_name": "應用程式介面", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "兩個程式之間「講話的窗口」。你按規矩發問（request），它按規矩回答（response），不用管對方內部怎麼運作。", "analogy": "像餐廳點餐櫃台：你看菜單點餐，廚房怎麼煮你不用管。", "related": ["endpoint", "http", "json", "request"] },
  { "slug": "library", "term": "library", "aliases": ["lib", "package", "module"], "zh_name": "函式庫 / 套件", "category": "concept", "langs": ["general"], "difficulty": 1, "plain": "別人寫好、可以直接拿來用的一包程式碼，省得自己重造輪子。", "analogy": "像去五金行買現成的螺絲，不用自己車一顆。", "related": ["framework", "dependency", "npm", "reinvent-the-wheel"] },
  { "slug": "framework", "term": "framework", "zh_name": "框架", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "一套「幫你把架子先搭好」的大工具，你只要照它的規則把東西填進去。跟 library 差在：library 你呼叫它、framework 它呼叫你。", "analogy": "像預售屋：格局都幫你隔好了，你只放家具。", "related": ["library"] },
  { "slug": "compile", "term": "compile", "zh_name": "編譯", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "把人寫的程式碼「翻譯成電腦看得懂的機器碼」的過程。翻譯時發現寫錯 → compile error。", "related": ["runtime", "syntax-error"] },
  { "slug": "runtime", "term": "runtime", "zh_name": "執行期", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "程式「實際在跑」的那段時間。runtime error 是跑起來才爆的錯（例如除以 0），跟 compile error（翻譯階段就抓到）不同。", "related": ["compile", "exception"] },
  { "slug": "syntax", "term": "syntax", "zh_name": "語法", "category": "concept", "langs": ["general"], "difficulty": 1, "plain": "程式語言的「文法規則」。少一個冒號、括號沒關 → syntax error，電腦看不懂。", "related": ["syntax-error"] },
  { "slug": "bug", "term": "bug", "zh_name": "程式錯誤 / 蟲", "category": "slang", "langs": ["general"], "difficulty": 1, "plain": "程式裡的錯誤或毛病。名字來自早期電腦真的有隻飛蛾卡在機器裡。", "related": ["debug", "heisenbug", "edge-case"] },
  { "slug": "debug", "term": "debug", "zh_name": "除錯", "category": "concept", "langs": ["general"], "difficulty": 1, "plain": "找出並修掉 bug 的過程。常用招：讀錯誤訊息最後一行、印出變數看、二分法縮小範圍。", "related": ["bug", "rubber-duck-debugging", "traceback"] },
  { "slug": "exception", "term": "exception", "zh_name": "例外", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "程式跑到「無法處理的狀況」時丟出的錯誤，例如檔案不存在。可以用 try/except 接住，讓程式別整個掛掉。", "related": ["runtime", "try-catch", "traceback"] },
  { "slug": "try-catch", "term": "try/catch (try/except)", "zh_name": "例外處理", "category": "syntax", "langs": ["general"], "difficulty": 2, "plain": "「先試試看，出錯我來接」的寫法。try 裡放可能出錯的動作，catch/except 裡放出錯時的補救。", "example": "try:\n    x = 1 / 0\nexcept ZeroDivisionError:\n    print(\"不能除以 0\")", "related": ["exception"] },
  { "slug": "class", "term": "class", "zh_name": "類別", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "「東西的模子」，定義一種物件有哪些資料跟能做什麼。用模子印出來的實體叫 object。", "analogy": "class 是餅乾模、object 是印出來的餅乾。", "related": ["object", "method", "inheritance"] },
  { "slug": "object", "term": "object", "zh_name": "物件", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "用 class（模子）做出來的實體，帶著自己的資料跟能力。", "related": ["class", "method"] },
  { "slug": "method", "term": "method", "zh_name": "方法", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "屬於某個物件的函式，就是「這個物件會做的動作」。例如 list 的 .append()。", "example": "\"abc\".upper()  # 字串的 method", "related": ["function", "class", "object"] },
  { "slug": "inheritance", "term": "inheritance", "zh_name": "繼承", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "讓一個 class 直接沿用另一個 class 的東西，再加自己的。像子類別「繼承」父類別的能力。", "related": ["class"] },
  { "slug": "async", "term": "async / asynchronous", "aliases": ["asynchronous"], "zh_name": "非同步", "category": "concept", "langs": ["javascript", "python"], "difficulty": 3, "plain": "「不用等它做完就先做別的」。例如發出網路請求後不呆等，等資料回來再處理，程式不會卡住。", "analogy": "像點餐後拿號碼牌先去坐，好了再叫你，而不是站在櫃台前發呆。", "related": ["callback", "promise", "await"] },
  { "slug": "callback", "term": "callback", "zh_name": "回呼函式", "category": "concept", "langs": ["javascript"], "difficulty": 3, "plain": "「事情做完後要執行的函式」，你先把它交給對方，對方好了再幫你按下去。", "related": ["async", "promise", "function"] },
  { "slug": "promise", "term": "Promise", "zh_name": "承諾", "category": "concept", "langs": ["javascript"], "difficulty": 3, "plain": "代表「一件還沒做完的事、之後會給你結果」的物件。可以掛 .then() 等它成功、.catch() 接失敗。", "related": ["async", "await", "callback"] },
  { "slug": "await", "term": "await", "zh_name": "等待", "category": "syntax", "langs": ["javascript", "python"], "difficulty": 3, "plain": "在非同步函式裡「等這件事有結果再往下」，但不會卡住整個程式。要配 async 一起用。", "related": ["async", "promise"] },
  { "slug": "closure", "term": "closure", "zh_name": "閉包", "category": "concept", "langs": ["javascript", "python"], "difficulty": 3, "plain": "函式「記住它出生時周圍的變數」，就算離開那個環境還是拿得到。常用來做「私有的計數器」。", "related": ["scope", "function"] },
  { "slug": "scope", "term": "scope", "zh_name": "作用域", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "變數「能被看到的範圍」。函式裡宣告的變數，通常只有函式裡看得到，外面看不到。", "related": ["closure", "variable", "hoisting"] },
  { "slug": "mutable", "term": "mutable / immutable", "aliases": ["immutable"], "zh_name": "可變 / 不可變", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "mutable = 內容可以就地改（如 list）；immutable = 不能改，要改只能做一個新的（如字串、tuple）。", "related": ["reference-vs-value"] },
  { "slug": "reference-vs-value", "term": "reference vs value", "zh_name": "傳參考 vs 傳值", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "傳值 = 給對方一份影本，改了不影響原本；傳參考 = 給對方原件的位址，改了原本也會變。新手很多 bug 出在這。", "related": ["mutable", "pointer"] },
  { "slug": "hash", "term": "hash", "zh_name": "雜湊", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "把任意資料壓成一串固定長度的「指紋」。同樣輸入永遠同樣指紋，但從指紋反推不回原文。用來查表、比對、存密碼。", "related": ["hash", "dictionary-term"] },
  { "slug": "stack", "term": "stack", "zh_name": "堆疊", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "後進先出（LIFO）的資料結構：最後放的最先拿。", "analogy": "像疊盤子，拿一定從最上面（最後放的）拿。", "related": ["queue", "stack-overflow"] },
  { "slug": "queue", "term": "queue", "zh_name": "佇列", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "先進先出（FIFO）的資料結構：先來的先處理。", "analogy": "像排隊買票，先排的先買到。", "related": ["stack"] },
  { "slug": "pointer", "term": "pointer", "zh_name": "指標", "category": "concept", "langs": ["c", "cpp"], "difficulty": 3, "plain": "存「某個東西的記憶體地址」的變數，等於一張「它住哪」的紙條，而不是東西本身。C/C++ 常見。", "related": ["reference-vs-value", "null-pointer"] },
  { "slug": "refactor", "term": "refactor", "zh_name": "重構", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "在「不改變功能」的前提下，把程式碼整理得更乾淨好維護。像整理房間，東西一樣多但好找了。", "related": ["technical-debt", "code-smell"] },
  { "slug": "deprecate", "term": "deprecated", "zh_name": "已棄用", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "官方標記「這東西以後別用了、之後會拿掉」，但現在還能動。看到就該換新做法。", "related": [] },
  { "slug": "dependency", "term": "dependency", "aliases": ["dep"], "zh_name": "相依套件", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "你的專案「依賴」的別人程式碼。它壞了或版本不合，你的專案也可能跟著壞。", "related": ["library", "npm", "dependency-hell"] },
  { "slug": "html", "term": "HTML", "zh_name": "超文本標記語言", "category": "concept", "langs": ["html"], "difficulty": 1, "plain": "決定網頁「有哪些內容、怎麼排」的語言，用一堆 <標籤> 標記標題、段落、圖片。它管結構，不管好不好看（那是 CSS）。", "related": ["css", "dom"] },
  { "slug": "css", "term": "CSS", "zh_name": "層疊樣式表", "category": "concept", "langs": ["css"], "difficulty": 1, "plain": "決定網頁「長怎樣」的語言：顏色、字體、大小、排版、動畫。HTML 管內容、CSS 管外觀。", "related": ["html", "flexbox"] },
  { "slug": "dom", "term": "DOM", "aliases": ["document object model"], "zh_name": "文件物件模型", "category": "concept", "langs": ["javascript", "html"], "difficulty": 2, "plain": "瀏覽器把網頁變成一棵「可以用程式操作的樹」。JavaScript 靠它抓元素、改內容、加事件。", "related": ["html", "javascript"] },
  { "slug": "http", "term": "HTTP", "zh_name": "超文本傳輸協定", "category": "concept", "langs": ["general"], "difficulty": 2, "plain": "瀏覽器跟伺服器「講話的規矩」。你發 request、它回 response，每次都帶一個狀態碼（200 成功、404 找不到、500 伺服器爆了）。", "related": ["api", "request", "status-code", "cors"] },
  { "slug": "json", "term": "JSON", "zh_name": "JSON 資料格式", "category": "concept", "langs": ["general"], "difficulty": 1, "plain": "一種輕巧、人也看得懂的資料格式，用大括號跟鍵值對表示。程式之間傳資料超常用。", "example": "{\"name\": \"小明\", \"age\": 18}", "related": ["api", "http"] },
  { "slug": "git", "term": "git", "zh_name": "Git 版本控制", "category": "tool", "langs": ["general"], "difficulty": 2, "plain": "幫程式碼「存檔＋記錄每次改了什麼」的工具，可以隨時回到過去版本、也能多人合作不打架。", "analogy": "像遊戲的存檔點，隨時能讀回某一關。", "related": ["commit", "branch", "merge", "pull-request"] },
