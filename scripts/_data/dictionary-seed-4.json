[
  { "slug": "ship-it", "term": "ship it", "zh_name": "出貨 / 上線", "category": "slang", "langs": ["general"], "difficulty": 1, "plain": "「做好了，發布上線吧！」。ship = 把產品送出去給使用者用。", "related": ["mvp", "hotfix"] },
  { "slug": "dogfooding", "term": "dogfooding", "zh_name": "吃自己的狗糧", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "「自己先用自己做的產品」。連自己都不想用，怎麼期待別人用？用了才會發現問題。", "related": ["mvp"] },
  { "slug": "legacy-code", "term": "legacy code", "zh_name": "遺留程式碼", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "很久以前寫的、沒人敢動、又不能不維護的舊程式碼。常常沒測試、沒文件、原作者早跑了。", "related": ["technical-debt", "spaghetti-code", "bus-factor"] },
  { "slug": "greenfield-brownfield", "term": "greenfield / brownfield", "zh_name": "全新 / 既有專案", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "greenfield =「一張白紙從頭做」，爽但沒參考；brownfield =「在既有系統上改」，處處要遷就舊東西。", "related": ["legacy-code"] },
  { "slug": "scope-creep", "term": "scope creep", "zh_name": "範圍蔓延", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "需求「一直偷偷長大」：本來做 A，做著做著變成要 A+B+C，時程就爆了。要學會踩煞車。", "related": ["yagni", "mvp", "feature-creep"] },
  { "slug": "feature-creep", "term": "feature creep", "zh_name": "功能膨脹", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "功能一直加、越塞越多，結果產品變複雜難用。加法容易，減法才是本事。", "related": ["scope-creep", "yagni", "kiss"] },
  { "slug": "happy-path", "term": "happy path", "zh_name": "快樂路徑", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "「一切順利、使用者乖乖照劇本走」的情況。新手只顧 happy path，忘了處理出錯的 sad path（空值、亂填、斷網）。", "related": ["edge-case", "sad-path"] },
  { "slug": "sad-path", "term": "sad path / error path", "zh_name": "錯誤路徑", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "「事情出錯」的情況：使用者亂填、網路斷、檔案不見。把 sad path 處理好，程式才穩。", "related": ["happy-path", "edge-case", "exception"] },
  { "slug": "smoke-test", "term": "smoke test", "zh_name": "冒煙測試", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "上線後「跑一輪最基本的功能」確認沒整個燒起來。名字來自硬體通電看會不會冒煙。", "related": ["regression", "unittest"] },
  { "slug": "canary", "term": "canary release", "zh_name": "金絲雀發布", "category": "slang", "langs": ["general"], "difficulty": 3, "plain": "新版本「先放給一小群人用」，沒事再全面推。名字來自礦工帶金絲雀下礦：牠先出事就知道有毒氣。", "related": ["ship-it", "rollback"] },
  { "slug": "rollback", "term": "rollback", "zh_name": "回滾", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "新版出包，「退回上一個正常的版本」止血。所以部署前要留好退路。", "related": ["hotfix", "canary", "commit"] },
  { "slug": "postmortem", "term": "postmortem", "zh_name": "事後檢討", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "出大包後「不罵人、只檢討怎麼發生的、怎麼避免再發生」的會。健康團隊對事不對人（blameless）。", "related": ["rca", "regression"] },
  { "slug": "rca", "term": "root cause analysis", "aliases": ["RCA"], "zh_name": "根因分析", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "「一直問為什麼」直到找到真正的根本原因，而不是只修表面。常用「五個為什麼」。", "related": ["postmortem", "debug"] },
  { "slug": "premature-optimization", "term": "premature optimization", "zh_name": "過早優化", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "「還沒確定哪裡慢就急著優化」，常是浪費時間又把程式弄複雜。名言：過早優化是萬惡之源。先能動、再量測、才優化。", "related": ["over-engineering", "big-o", "yagni"] },
  { "slug": "over-engineering", "term": "over-engineering", "zh_name": "過度設計", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "把簡單問題「做得太複雜、想太多未來」。彈性架構聽起來很潮，但用不到就是負擔。", "related": ["premature-optimization", "yagni", "kiss", "gold-plating"] },
  { "slug": "gold-plating", "term": "gold plating", "zh_name": "鍍金", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "「沒人要求，自己一直加細節、加到完美」。時間都花在沒人在乎的地方。", "related": ["over-engineering", "yagni"] },
  { "slug": "cargo-cult", "term": "cargo cult programming", "zh_name": "貨物崇拜式編程", "category": "slang", "langs": ["general"], "difficulty": 3, "plain": "「照抄別人的做法但不懂為什麼」。看到就複製貼上，能動就好，其實根本不需要或用錯場合。", "related": ["copy-paste", "boilerplate"] },
  { "slug": "works-on-my-machine", "term": "works on my machine", "zh_name": "我電腦上明明可以", "category": "slang", "langs": ["general"], "difficulty": 1, "plain": "工程師名言：「在我電腦上跑得好好的啊！」通常是環境/版本/設定不一樣造成的差異。Docker 就是為了解決它。", "related": ["environment-variable", "dependency-hell"] },
  { "slug": "quick-and-dirty", "term": "quick and dirty / hack / kludge", "aliases": ["kludge", "hack"], "zh_name": "又快又髒的解法", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "「先求能動、不管漂不漂亮」的臨時解。短期救急、長期就是技術債。", "related": ["technical-debt", "band-aid", "hotfix"] },
  { "slug": "band-aid", "term": "band-aid fix", "zh_name": "OK 繃式修法", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "「只貼個 OK 繃止血、沒真的治好病根」的修法。症狀壓下去了，根本問題還在。", "related": ["quick-and-dirty", "rca", "technical-debt"] },
  { "slug": "syntactic-sugar", "term": "syntactic sugar", "zh_name": "語法糖", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "「讓程式更好寫好讀、但沒新功能」的簡便語法。像 f-string、三元運算式，甜甜的但本質沒變。", "related": ["f-string", "ternary", "list-comprehension"] },
  { "slug": "leaky-abstraction", "term": "leaky abstraction", "zh_name": "會漏的抽象", "category": "slang", "langs": ["general"], "difficulty": 3, "plain": "本來想「包起來讓你不用管底層」，但底層細節還是漏出來咬你。所有抽象多少都會漏。", "related": ["orm", "framework"] },
  { "slug": "copy-paste", "term": "copy-paste programming", "zh_name": "複製貼上編程", "category": "slang", "langs": ["general"], "difficulty": 1, "plain": "一直複製貼上重複的程式碼，改一處要改十處。這正是 DRY 原則要你避免的。", "related": ["dry", "code-smell", "cargo-cult"] },
  { "slug": "poc", "term": "POC / spike", "aliases": ["proof of concept", "spike"], "zh_name": "概念驗證", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "「快速做個小東西驗證『這行不行得通』」，用完常常丟掉。跟 MVP 差在 POC 只為驗證技術、不給使用者用。", "related": ["mvp"] },
  { "slug": "eli5", "term": "ELI5", "aliases": ["explain like I'm 5"], "zh_name": "講白話一點", "category": "slang", "langs": ["general"], "difficulty": 1, "plain": "「解釋得像對五歲小孩講一樣」，要求最白話、最少術語的說明。這本辭典的精神就是 ELI5。", "related": ["foobar"] },
  { "slug": "rtfm", "term": "RTFM", "zh_name": "先去看文件", "category": "slang", "langs": ["general"], "difficulty": 1, "plain": "「請先讀那個(該死的)手冊」。老鳥對「不先查文件就發問」的（有點沒禮貌的）回應。發問前先 Google 跟看官方文件是好習慣。", "related": ["til"] },
  { "slug": "pebkac", "term": "PEBKAC / ID-10-T", "zh_name": "問題出在使用者", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "「問題存在於鍵盤和椅子之間」——委婉地說「不是電腦壞，是人操作錯」。工程師的黑色幽默。", "related": ["works-on-my-machine"] },
  { "slug": "wontfix", "term": "wontfix / works as intended", "zh_name": "不修 / 這是正常的", "category": "slang", "langs": ["general"], "difficulty": 1, "plain": "回報 bug 時常見的關閉標籤：wontfix =「知道了但不打算修」；works as intended =「這不是 bug，本來就設計成這樣」。", "related": ["bug", "edge-case"] },
  { "slug": "corner-case", "term": "corner case / gotcha", "zh_name": "角落案例 / 陷阱", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "gotcha =「抓到你！」指容易踩的隱藏陷阱；corner case 是多個罕見條件同時發生的極端情況，比 edge case 更角落。", "related": ["edge-case", "footgun", "default-mutable-arg"] },
  { "slug": "imposter-syndrome", "term": "imposter syndrome", "zh_name": "冒牌者症候群", "category": "slang", "langs": ["general"], "difficulty": 1, "plain": "「覺得自己其實不夠格、遲早被拆穿」的心理。幾乎每個工程師都有過——你不孤單，繼續學就對了。", "related": ["til"] },
  { "slug": "tabs-vs-spaces", "term": "tabs vs spaces", "zh_name": "Tab 與空格之爭", "category": "slang", "langs": ["general"], "difficulty": 1, "plain": "工程師界永恆的「聖戰」：縮排該用 Tab 還是空格。其實用工具自動統一就好，別為它吵架。Python 界慣例是 4 個空格。", "related": ["indentation", "bikeshedding", "pep8"] },
  { "slug": "silver-bullet", "term": "no silver bullet", "zh_name": "沒有銀彈", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "「沒有一招解決所有問題的萬靈丹」。看到「用了 X 就搞定一切」的話術，多半要保留。", "related": ["over-engineering"] },
  { "slug": "big-ball-of-mud", "term": "big ball of mud", "zh_name": "大泥球", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "「沒有架構、東西全糊在一起」的系統，像一大坨泥巴，動哪裡都牽一髮動全身。spaghetti code 的系統級版本。", "related": ["spaghetti-code", "technical-debt", "legacy-code"] },
  { "slug": "standup", "term": "standup / sprint / backlog", "zh_name": "站會 / 衝刺 / 待辦清單", "category": "slang", "langs": ["general"], "difficulty": 2, "plain": "敏捷開發的日常：standup 每天站著開的短會（昨天做啥、今天做啥、卡在哪）；sprint 一到兩週的開發衝刺；backlog 還沒做的需求清單。", "related": ["blocker", "wip"] },
  { "slug": "blocker", "term": "blocker", "zh_name": "阻礙 / 卡點", "category": "slang", "langs": ["general"], "difficulty": 1, "plain": "「讓你做不下去的東西」——等別人、缺權限、有 bug。站會最重要就是講出你的 blocker 讓人幫你排除。", "related": ["standup", "wip"] },
  { "slug": "ping", "term": "ping / poke", "zh_name": "敲一下 / 提醒", "category": "slang", "langs": ["general"], "difficulty": 1, "plain": "「敲你一下」——傳訊息提醒或找某人。來自網路測試指令 ping（丟封包看對方在不在）。", "related": ["webhook"] },
  { "slug": "latency-throughput", "term": "latency vs throughput", "zh_name": "延遲 / 吞吐量", "category": "concept", "langs": ["general"], "difficulty": 3, "plain": "latency =「一件事要等多久」（越低越好）；throughput =「單位時間能處理多少」（越高越好）。像水管：延遲是水流到要多久、吞吐是每秒流多少。", "related": ["big-o", "cache"] }
]
